            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Start"
            }
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "title": "Count"
            }
